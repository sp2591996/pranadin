    "yatra.disclaimer": { "en": "Cultural and travel information only. No bookings are made here. Timings, passes, fares and rules change, so confirm with the temple office or official sources before you go.", "hi": { "text": "यह केवल सांस्कृतिक और यात्रा संबंधी जानकारी है। यहाँ कोई बुकिंग नहीं होती। समय, पास, किराये और नियम बदलते रहते हैं, इसलिए जाने से पहले मंदिर कार्यालय या आधिकारिक स्रोतों से पुष्टि करें।", "reviewed": false }, "mr": { "text": "ही केवळ सांस्कृतिक आणि प्रवासविषयक माहिती आहे. येथे कोणतेही आरक्षण होत नाही. वेळा, पास, भाडे आणि नियम बदलतात, म्हणून जाण्यापूर्वी मंदिर कार्यालय किंवा अधिकृत स्रोतांकडून खात्री करा.", "reviewed": false } },
    "yatra.planner.open": { "en": "Trip planner", "hi": { "text": "यात्रा योजना", "reviewed": false }, "mr": { "text": "सहल नियोजक", "reviewed": false } },
    "yatra.planner.title": { "en": "Trip planner", "hi": { "text": "यात्रा योजना", "reviewed": false }, "mr": { "text": "सहल नियोजक", "reviewed": false } },
    "yatra.planner.intro": { "en": "Pick places and how many days at each. You get one day-by-day plan. It is saved on this device only.", "hi": { "text": "स्थान चुनें और हर जगह कितने दिन रुकना है बताएँ। आपको एक दिन-प्रतिदिन की योजना मिलेगी। यह केवल इसी उपकरण पर सहेजी जाती है।", "reviewed": false }, "mr": { "text": "ठिकाणे निवडा आणि प्रत्येक ठिकाणी किती दिवस थांबायचे ते सांगा. तुम्हाला दिवसागणिक एकत्रित योजना मिळेल. ती फक्त याच उपकरणावर जतन होते.", "reviewed": false } },
    "yatra.planner.notSaved": { "en": "This device is not keeping the plan between visits. Copy or print it before you leave.", "hi": { "text": "यह उपकरण योजना को अगली बार के लिए नहीं रख रहा है। जाने से पहले इसे कॉपी या प्रिंट कर लें।", "reviewed": false }, "mr": { "text": "हे उपकरण योजना पुढील भेटीसाठी ठेवत नाही. निघण्यापूर्वी ती कॉपी किंवा प्रिंट करा.", "reviewed": false } },
