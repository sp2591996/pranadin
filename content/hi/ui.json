    "onb.welcome.title": {
      "text": "प्राणदिन में आपका स्वागत है",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.body": {
      "text": "रोज़ कुछ मिनट श्वास, ध्यान और चिंतन के लिए, साथ में कई परंपराओं के पर्व और पावन दिन।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.point1": {
      "text": "कोई खाता नहीं चाहिए। आपकी साधना और डायरी इसी फ़ोन पर रहती है।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.point2": {
      "text": "बीटा के दौरान मुफ़्त, कोई विज्ञापन नहीं।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.point3": {
      "text": "हम अपने स्रोत बताते हैं, और हर हिंदी व मराठी पाठ दिखने से पहले एक व्यक्ति उसे जाँचता है।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.cta": {
      "text": "शुरू करें",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.title": {
      "text": "शुरू करने से पहले",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.body": {
      "text": "प्राणदिन सौम्य श्वास और ध्यान अभ्यास, और परंपराओं व पर्वों की जानकारी देता है। यह चिकित्सा सलाह नहीं है, और डॉक्टर, थेरेपिस्ट या आपके अपने गुरु की जगह नहीं लेता।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.point1": {
      "text": "धीरे-धीरे करें। दर्द, चक्कर, साँस फूलने या घबराहट पर रुक जाएँ।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.point2": {
      "text": "अगर आप गर्भवती हैं, या आपको हृदय रोग, उच्च या निम्न रक्तचाप, ग्लूकोमा, मिर्गी, हाल की सर्जरी या चोट, या कोई मानसिक स्वास्थ्य समस्या है, तो पहले डॉक्टर से पूछें।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.point3": {
      "text": "आपातकाल में 112 पर कॉल करें। मानसिक स्वास्थ्य सहायता के लिए टेली-मानस 14416 पर कॉल करें (टोल-फ़्री)।",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.cta": {
      "text": "समझ गए, आगे बढ़ें",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.more": {
      "text": "पूरी स्वास्थ्य सूचना पढ़ें",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
