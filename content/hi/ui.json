    "yoga.safety.title": {
      "text": "शुरू करने से पहले",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.1": {
      "text": "अपनी सुविधा के भीतर रहें। दर्द, चक्कर या खिंचाव लगे तो रुकें और आराम करें।",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.2": {
      "text": "यह चिकित्सा सलाह नहीं है। चोट या कोई स्वास्थ्य समस्या हो, या आप गर्भवती हों, तो शुरू करने से पहले अपने स्थानीय स्वास्थ्य विशेषज्ञ से मिलें।",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.3": {
      "text": "हर आसन में श्वास सहज और सरल रखें। उस पर ज़ोर न डालें।",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.4": {
      "text": "पहले शरीर को गरम करें, धीरे चलें और जो आसन आज ठीक न लगे उसे छोड़ दें।",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
