    "yoga.safety.title": {
      "text": "सुरू करण्यापूर्वी",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.1": {
      "text": "आपल्या सोयीच्या मर्यादेत रहा. वेदना, चक्कर किंवा ताण जाणवला तर थांबा आणि विश्रांती घ्या.",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.2": {
      "text": "हा वैद्यकीय सल्ला नाही. दुखापत किंवा आरोग्य समस्या असल्यास, किंवा आपण गर्भवती असल्यास, सुरू करण्यापूर्वी आपल्या स्थानिक आरोग्य तज्ज्ञांना भेटा.",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.3": {
      "text": "प्रत्येक आसनात श्वास सहज आणि सुलभ ठेवा. त्यावर जोर देऊ नका.",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
    "yoga.safety.4": {
      "text": "आधी शरीर गरम करा, हळू चला आणि आज जे आसन योग्य वाटत नाही ते सोडून द्या.",
      "reviewed": false,
      "reviewer": null,
      "reviewedOn": null
    },
