    "onb.welcome.title": {
      "text": "प्राणदिनमध्ये तुमचे स्वागत आहे",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.body": {
      "text": "रोज काही मिनिटे श्वास, ध्यान आणि चिंतनासाठी, सोबत अनेक परंपरांचे सण आणि पवित्र दिवस.",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.point1": {
      "text": "खाते लागत नाही. तुमची साधना आणि रोजनिशी याच फोनवर राहते.",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.point2": {
      "text": "बीटा काळात मोफत, जाहिराती नाहीत.",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.point3": {
      "text": "आम्ही आमचे स्रोत सांगतो, आणि प्रत्येक हिंदी व मराठी मजकूर दिसण्यापूर्वी एक व्यक्ती तो तपासते.",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.welcome.cta": {
      "text": "सुरू करा",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.title": {
      "text": "सुरुवात करण्यापूर्वी",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.body": {
      "text": "प्राणदिन सौम्य श्वसन व ध्यानाचे सराव आणि परंपरा व सणांची माहिती देतो. हा वैद्यकीय सल्ला नाही, आणि डॉक्टर, थेरपिस्ट किंवा तुमच्या स्वतःच्या गुरूंची जागा घेत नाही.",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.point1": {
      "text": "हळूहळू करा. वेदना, चक्कर, धाप किंवा अस्वस्थता जाणवल्यास थांबा.",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.point2": {
      "text": "तुम्ही गर्भवती असाल, किंवा तुम्हाला हृदयविकार, उच्च किंवा कमी रक्तदाब, काचबिंदू, अपस्मार (फिट्स), नुकतीच शस्त्रक्रिया किंवा दुखापत, किंवा मानसिक आरोग्याची समस्या असेल, तर आधी डॉक्टरांना विचारा.",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.point3": {
      "text": "आपत्कालीन स्थितीत 112 वर कॉल करा. मानसिक आरोग्याच्या मदतीसाठी टेली-मानस 14416 वर कॉल करा (टोल-फ्री).",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.cta": {
      "text": "समजले, पुढे चला",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
    "onb.safety.more": {
      "text": "संपूर्ण आरोग्य सूचना वाचा",
      "reviewed": true,
      "reviewer": "Board",
      "reviewedOn": "2026-11-17"
    },
